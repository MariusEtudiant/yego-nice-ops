# Snapshots bruts : volumineux et nombreux (~720/jour). On versionne une version
# compactee par jour (data/compact/) et un echantillon, pas les 5000+ fichiers bruts.
data/raw/
logs/
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# OS
.DS_Store
Thumbs.db

# dbt
transform/target/
transform/logs/
transform/dbt_packages/

# Recalcules a chaque execution (deja inclus dans data/compact/)
data/tracks/
reports/*.html

# Power BI Project : cache local et reglages propres au poste
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf

# Flux statiques quotidiens : deja versionnes sur la branche data (collecte dans le cloud)
data/static/city=*/date=*/
