	table fct_battery_waits
		lineageTag: 2589f364-9c22-57e7-a235-b90cd4ae9245

		measure 'Median Battery Wait (h)' =
				CALCULATE (
				    MEDIAN ( fct_battery_waits[wait_hours] ),
				    fct_battery_waits[outcome] = "swapped",
				    fct_battery_waits[left_censored] = FALSE ()
				)
			formatString: 0.0
			lineageTag: d2e18227-dc7b-5ff8-b79d-7496530718b7

		measure 'Battery Waits over 12h %' =
				DIVIDE (
				    CALCULATE ( COUNTROWS ( fct_battery_waits ), fct_battery_waits[outcome] = "swapped",
				        fct_battery_waits[left_censored] = FALSE (), fct_battery_waits[wait_hours] > 12 ),
				    CALCULATE ( COUNTROWS ( fct_battery_waits ), fct_battery_waits[outcome] = "swapped",
				        fct_battery_waits[left_censored] = FALSE () )
				)
			formatString: 0%
			lineageTag: cb39058d-2f8e-5b37-8b19-c3ac1d08e8d3

		measure 'Scooters Waiting Now' = CALCULATE ( COUNTROWS ( fct_battery_waits ), fct_battery_waits[outcome] = "ongoing" )
			formatString: #,0
			lineageTag: eaab56aa-54f6-5129-aaa0-cb653751fb4a

		column city
			dataType: string
			isHidden
			lineageTag: 2a91ad14-331e-5d20-9760-56fe9615f364
