	table fct_battery_swaps
		lineageTag: 303cdeef-252c-54af-ad08-ceb0e883af8d

		measure 'Battery Swaps' = CALCULATE ( COUNTROWS ( fct_battery_swaps ), fct_battery_swaps[is_confirmed] = TRUE () )
			formatString: #,0
			lineageTag: cff80ff8-3029-5c22-b876-80cb2601645b

		measure 'Swaps After Evening Peak %' =
				DIVIDE (
				    CALCULATE ( [Battery Swaps], dim_hour[local_hour] >= 20 || dim_hour[local_hour] < 2 ),
				    [Battery Swaps]
				)
			formatString: 0%
			lineageTag: af71318d-22fc-5456-9571-e33047a3138e

		measure 'Average Battery Gain' = CALCULATE ( AVERAGE ( fct_battery_swaps[battery_gain_pct] ), fct_battery_swaps[is_confirmed] = TRUE () )
			formatString: 0
			lineageTag: fb5a2b79-d24f-519f-aa8d-1788f59c0fb7

		column city
