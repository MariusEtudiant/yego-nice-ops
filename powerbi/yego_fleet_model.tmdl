	table fct_zone_hourly
		lineageTag: 21ad3551-0ca1-55bf-b5fd-e8168644f966

		measure 'Departures per Day' = SUM ( fct_zone_hourly[departures_per_day] )
			formatString: #,0.0
			lineageTag: 3ff16423-612a-598f-895a-937ab8f7d737

		measure 'Arrivals per Day' = SUM ( fct_zone_hourly[arrivals_per_day] )
			formatString: #,0.0
			lineageTag: efd7313d-14d2-53a3-9af2-2e2048ba93fb

		measure 'Net Flow per Day' = [Arrivals per Day] - [Departures per Day]
			formatString: +#,0.0;-#,0.0;0
			lineageTag: 63a05e4f-bc86-525e-bd07-897ff28a90b2

		measure 'Zones in Shortage' =
				COUNTROWS (
				    FILTER (
				        SUMMARIZE ( fct_zone_hourly, fct_zone_hourly[zone_id], fct_zone_hourly[local_hour] ),
				        CALCULATE ( SUM ( fct_zone_hourly[avg_available] ) ) < 1
				            && CALCULATE ( SUM ( fct_zone_hourly[departures_per_day] ) ) >= 1
				    )
				)
			formatString: #,0
			lineageTag: 19c8fbe1-cbf8-56cb-9ec9-b714d6f119e5

		measure 'Peak Demand Hour' =
				MAXX (
				    TOPN ( 1, VALUES ( dim_hour[local_hour] ), [Departures per Day], DESC ),
				    dim_hour[local_hour]
				)
			formatString: 0
			lineageTag: 9068d953-3d44-55f0-be67-d3bfcf8a7c06

		column city
			dataType: string
			isHidden
			lineageTag: 2c83b318-a8dd-5ac1-b754-4884485db97b
			summarizeBy: none
			sourceColumn: city

			annotation SummarizationSetBy = Automatic

		column zone_id
			dataType: string
			isHidden
