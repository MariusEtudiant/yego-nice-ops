	table fct_fleet_hourly
		lineageTag: b41f3668-2842-58b2-a5c8-e4d513492d1b

		measure 'Listed Scooters' = AVERAGE ( fct_fleet_hourly[avg_listed] )
			formatString: #,0
			lineageTag: cd67e53c-36c0-5f24-9a58-e6d989c428df

		measure 'Available Scooters' = AVERAGE ( fct_fleet_hourly[avg_available] )
			formatString: #,0
			lineageTag: e37094e3-4f42-5978-a763-4e4211638131

		measure 'Availability Rate' = DIVIDE ( SUM ( fct_fleet_hourly[avg_available] ), SUM ( fct_fleet_hourly[avg_listed] ) )
			formatString: 0.0%
			lineageTag: 266b159c-79c0-5cc4-b5d4-c7ad67a3cb76

		measure 'Waiting for Battery' = AVERAGE ( fct_fleet_hourly[avg_disabled_battery] )
			formatString: #,0
			lineageTag: 91331654-73e3-5ad6-9756-6891fb4bca40

		measure 'Disabled Other Reason' = AVERAGE ( fct_fleet_hourly[avg_disabled_other] )
			formatString: #,0
			lineageTag: ce8b8d4a-f0a0-5605-b108-9cb6ed9cd343

		measure 'Peak Battery Queue' =
				MAXX (
				    VALUES ( fct_fleet_hourly[hour_local] ),
				    CALCULATE ( SUM ( fct_fleet_hourly[avg_disabled_battery] ) )
				)
			formatString: #,0
			lineageTag: b13b42bf-635b-5272-aac0-a891dcd2b64f

		measure 'Available vs Daily Average' = [Available Scooters] - CALCULATE ( [Available Scooters], REMOVEFILTERS ( dim_hour ) )
			formatString: +#,0;-#,0;0
			lineageTag: 73d4e8e4-1f5c-5ed7-a3d7-3a1ecb1b05c0

		column city
			dataType: string
			isHidden
			lineageTag: 4517ea47-f737-5e58-b7ff-21a11991d203
			summarizeBy: none
			sourceColumn: city

			annotation SummarizationSetBy = Automatic

